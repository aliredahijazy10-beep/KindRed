generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  full_name     String
  email         String   @unique
  password_hash String
  phone_nb      String   @unique
  role          Role
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("users")
}

enum Role {
  user
  admin
}