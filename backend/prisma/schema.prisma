generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  full_name     String
  email         String   @unique
  password_hash String
  phone_nb      String   @unique
  role          Role
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  donor         Donor?
  admin         Admin?

  @@map("users")
}

model Donor {
  id                 Int        @id @default(autoincrement())
  blood_type         BloodType
  city               String
  birth_date         DateTime   @db.Date
  gender             Gender
  weight_kg          Float
  medical_notes      String?
  last_donation_date DateTime?
  user_id            Int        @unique
  user               User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([blood_type, city])
  @@map("donors")
}

model Admin {
  id           Int        @id @default(autoincrement())
  work_email   String     @unique
  organization String
  position     String
  work_city    String
  user_id      Int        @unique
  user         User       @relation(fields: [user_id], references: [id], onDelete: Restrict)
  requests     Requests[]
  @@map("admins")
}

model Requests {
  id                 Int           @id @default(autoincrement())
  patient_name       String
  blood_type         BloodType
  city               String
  hospital_name      String
  units_needed       Int           @default(1)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  needed_by_date     DateTime
  urgency            Urgency       @default(standard)
  status             RequestStatus @default(open)
  admin_id           Int
  admin              Admin         @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([blood_type, city, status])
  @@index([admin_id])
  @@map("blood_requests")
}

enum Role {
  user
  admin
}

enum BloodType {
  A_P  @map("A+")
  A_N  @map("A-")
  B_P  @map("B+")
  B_N  @map("B-")
  AB_P @map("AB+")
  AB_N @map("AB-")
  O_P  @map("O+")
  O_N  @map("0-")
}

enum Gender {
  male
  female
}

enum Urgency {
  critical
  high
  standard
}

enum RequestStatus {
  open
  fulfilled
  cancelled
  expired
}
